{
	"name": "buku-umkm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply buku-umkm-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply buku-umkm-db --remote",
		"auth:schema": "auth generate --config src/lib/server/auth.cli.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-cloudflare": "^7.2.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.4",
		"@types/sql.js": "^1.16.1",
		"@vitest/browser-playwright": "^4.1.12",
		"auth": "1.7.28",
		"better-auth": "1.7.28",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"shadcn-svelte": "^1.8.2",
		"sql.js": "^1.17.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^7.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1",
		"wrangler": "^4.168.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.577.0",
		"clsx": "^2.1.1",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.9",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
