{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "./src/worker-configuration.d.ts", "node"]
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts"],
