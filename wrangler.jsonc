{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buku-umkm",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buku-umkm-db",
			"database_id": "<YOUR_D1_DATABASE_ID>",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "buku-umkm-receipts"
		}
	],
	// Cloudflare Email Service (src/lib/server/email/) for password reset and email verification
	// mail. The sender is EMAIL_FROM, an address on a domain onboarded to Email Sending.
	// `wrangler dev` simulates this binding: it logs each message and saves its content to files.
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Workers Rate Limiting (src/lib/server/security/rate-limit.ts). namespace_id is any positive
	// integer, as a string, that no other rate limiter in your Cloudflare account uses. period
	// must be 10 or 60 seconds; counts are kept per Cloudflare location.
	"ratelimits": [
		{
			// Sign-in, sign-up and password attempts per account (normalized email).
			"name": "AUTH_EMAIL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// The same attempts per client IP; looser because carrier NAT puts many users on one IP.
			"name": "AUTH_IP_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			// Every other /api/* request, per signed-in user (per IP when signed out).
			"name": "API_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 120, "period": 60 }
		},
		{
			// /api/backup and /api/restore, per user.
			"name": "HEAVY_API_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 3, "period": 60 }
		}
	]
}
