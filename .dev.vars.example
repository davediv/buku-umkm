# Local settings for `pnpm preview` (the built Worker on wrangler dev). Copy to .dev.vars.
# `pnpm dev` (Vite) reads .env instead. Values here override vars in wrangler.jsonc.
# Production and staging values live in wrangler.jsonc (vars) and Worker secrets.

ORIGIN="http://localhost:8787"

# Better Auth signing secret: at least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Encrypts NPWP (tax ID) at rest: at least 32 characters. Changing it later makes stored
# NPWPs unreadable, so keep it stable per environment.
NPWP_ENCRYPTION_KEY=""

# Sender of password reset and verification emails. Locally the send_email binding is only
# simulated: messages are written under .wrangler/tmp/email/ instead of being delivered.
EMAIL_FROM="noreply@example.com"
